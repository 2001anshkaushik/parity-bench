# ---------------------------------------------------------------------------------------------
# WS-1 LlamaIndex service — ARCH-PARAMETERIZED (2026-08-14, Phase 2).
#
# Emulation would silently change every number and look like a framework difference, so the
# architecture is asserted, not assumed — but no longer HARDCODED to aarch64. Pass the arch you
# intend and the build fails loudly on any mismatch:
#     docker build --build-arg EXPECT_ARCH=x86_64 ...     (EC2)
#     docker build --build-arg EXPECT_ARCH=aarch64 ...    (this laptop)
# The assertion chain is unchanged in spirit:
#   1. --platform on every FROM
#   2. a build-time RUN that fails the build on the wrong arch (below, both stages)
#   3. the service reports platform.machine() in /manifest
#   4. the run manifest records the image digest
#
# Threads are pinned EXPLICITLY rather than inferred: os.cpu_count() reports the HOST's 14 inside
# a --cpus quota, so a container that lets torch/BLAS size their own pools recreates exactly the
# oversubscription pathology measured in A3_SERIALIZATION_FINDING.md (19% throughput, most of the
# concurrency scaling).
# ---------------------------------------------------------------------------------------------
ARG EXPECT_ARCH=x86_64
FROM --platform=$BUILDPLATFORM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS builder
ARG EXPECT_ARCH
RUN [ "$(uname -m)" = "$EXPECT_ARCH" ] || \
    (echo "ARCH ASSERT FAILED (builder): building on $(uname -m) but EXPECT_ARCH=$EXPECT_ARCH." && \
     echo "If this is intended, pass --build-arg EXPECT_ARCH=$(uname -m). Never emulate silently." && exit 1)
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY docker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the model into the image: a runtime fetch would land a multi-hundred-MB download inside the
# first measured window and would cross the slow VM filesystem boundary.
ENV HF_HOME=/opt/hf
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
m = SentenceTransformer('sentence-transformers/multi-qa-MiniLM-L6-cos-v1', device='cpu'); \
print('model baked, dim =', m.get_sentence_embedding_dimension())"

# ---------------------------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
ARG EXPECT_ARCH
RUN [ "$(uname -m)" = "$EXPECT_ARCH" ] || \
    (echo "ARCH ASSERT FAILED (runtime): $(uname -m) != EXPECT_ARCH=$EXPECT_ARCH" && exit 1)

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /opt/hf /opt/hf

# offline: no network at runtime, no model fetch during a measured run
ENV HF_HOME=/opt/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    TORCH_NUM_THREADS=1 \
    WS1_DEVICE=cpu \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY working/ws1 /app/ws1
COPY working/harness /app/harness
COPY docker/ladder.py /app/ladder.py

# The service stack, added as its OWN layer at the tail on purpose. docker/requirements.txt
# deliberately omits fastapi/uvicorn ("the ladder calls the pipeline directly and never starts a
# server") — but ws1/service.py:24 imports fastapi, so the image could not run the service at all.
# Adding them to docker/requirements.txt would invalidate the builder pip layer AND the baked-model
# layer, forcing a full rebuild including the model download. Installing here invalidates nothing
# above `COPY working/...`.
#
# Versions are the MEASURED venv's, read via importlib.metadata — same rule as
# docker/requirements.txt. uvloop/httptools are included because run_service.sh passes
# `--loop uvloop --http httptools`; without them uvicorn silently falls back to asyncio/h11 while
# /health keeps reporting uvloop from WS1_LOOP (declared != measured, in the direction that hides).
RUN pip install --no-cache-dir \
      fastapi==0.141.1 uvicorn==0.52.1 uvloop==0.22.1 httptools==0.8.0

RUN useradd -m -u 10001 ws1 && mkdir -p /app/out && chown -R ws1 /app
USER ws1

EXPOSE 8801

# 32 workers x 1 BLAS thread each (thread decision settled 2026-08-15; matches Shashi
# compose.yml:37-39,63-65,90 and Leela docker-compose.yml:71). The BLAS pins are already in the
# ENV block above and are unchanged; TORCH_INTEROP_THREADS stays UNSET on both arms, deliberately.
# WS1_WORKERS is read by uvicorn (--workers) AND by service.py:39 for its own /health report, so
# one variable keeps the two from disagreeing.
ENV WS1_WORKERS=32 \
    WS1_PORT=8801

# sh -c + exec: exec form cannot expand ${WS1_WORKERS}; `exec` keeps uvicorn as PID 1 so SIGTERM
# reaches it and workers shut down cleanly instead of being killed at the 10 s timeout.
ENTRYPOINT ["sh", "-c", "exec python -m uvicorn ws1.service:app --host 0.0.0.0 --port 8801 --workers ${WS1_WORKERS:-32} --loop uvloop --http httptools --no-access-log --log-level warning --timeout-keep-alive 30"]
