# ---------------------------------------------------------------------------------------------
# WS-1 LlamaIndex service — ARCH-PARAMETERIZED (2026-08-14, Phase 2).
#
# Emulation would silently change every number and look like a framework difference, so the
# architecture is asserted, not assumed — but no longer HARDCODED to aarch64. Pass the arch you
# intend and the build fails loudly on any mismatch:
#     docker build --build-arg EXPECT_ARCH=x86_64 ...     (EC2)
#     docker build --build-arg EXPECT_ARCH=aarch64 ...    (this laptop)
# The assertion chain is unchanged in spirit:
#   1. --platform on every FROM
#   2. a build-time RUN that fails the build on the wrong arch (below, both stages)
#   3. the service reports platform.machine() in /manifest
#   4. the run manifest records the image digest
#
# Threads are pinned EXPLICITLY rather than inferred: os.cpu_count() reports the HOST's 14 inside
# a --cpus quota, so a container that lets torch/BLAS size their own pools recreates exactly the
# oversubscription pathology measured in A3_SERIALIZATION_FINDING.md (19% throughput, most of the
# concurrency scaling).
# ---------------------------------------------------------------------------------------------
ARG EXPECT_ARCH=x86_64
FROM --platform=$BUILDPLATFORM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS builder
ARG EXPECT_ARCH
RUN [ "$(uname -m)" = "$EXPECT_ARCH" ] || \
    (echo "ARCH ASSERT FAILED (builder): building on $(uname -m) but EXPECT_ARCH=$EXPECT_ARCH." && \
     echo "If this is intended, pass --build-arg EXPECT_ARCH=$(uname -m). Never emulate silently." && exit 1)
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY docker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the model into the image: a runtime fetch would land a multi-hundred-MB download inside the
# first measured window and would cross the slow VM filesystem boundary.
ENV HF_HOME=/opt/hf
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
m = SentenceTransformer('sentence-transformers/multi-qa-MiniLM-L6-cos-v1', device='cpu'); \
print('model baked, dim =', m.get_sentence_embedding_dimension())"

# ---------------------------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
ARG EXPECT_ARCH
RUN [ "$(uname -m)" = "$EXPECT_ARCH" ] || \
    (echo "ARCH ASSERT FAILED (runtime): $(uname -m) != EXPECT_ARCH=$EXPECT_ARCH" && exit 1)

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /opt/hf /opt/hf

# offline: no network at runtime, no model fetch during a measured run
ENV HF_HOME=/opt/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    TORCH_NUM_THREADS=1 \
    WS1_DEVICE=cpu \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY working/ws1 /app/ws1
COPY working/harness /app/harness
COPY docker/ladder.py /app/ladder.py

# The service stack, added as its OWN layer at the tail on purpose. docker/requirements.txt
# deliberately omits fastapi/uvicorn ("the ladder calls the pipeline directly and never starts a
# server") — but ws1/service.py:24 imports fastapi, so the image could not run the service at all.
# Adding them to docker/requirements.txt would invalidate the builder pip layer AND the baked-model
# layer, forcing a full rebuild including the model download. Installing here invalidates nothing
# above `COPY working/...`.
#
# Versions are the MEASURED venv's, read via importlib.metadata — same rule as
# docker/requirements.txt. uvloop/httptools are included because run_service.sh passes
# `--loop uvloop --http httptools`; without them uvicorn silently falls back to asyncio/h11 while
# /health keeps reporting uvloop from WS1_LOOP (declared != measured, in the direction that hides).
RUN pip install --no-cache-dir \
      fastapi==0.141.1 uvicorn==0.52.1 uvloop==0.22.1 httptools==0.8.0

# THE MODEL BAKE AT LINE 34 DOES NOT COVER THE RUNTIME LOADER. Root cause, measured:
#
#   llama_index/embeddings/huggingface/base.py:145   cache_folder = cache_folder or get_cache_dir()
#   llama_index/core/utils.py:442-445                LLAMA_INDEX_CACHE_DIR, else
#                                                    platformdirs.user_cache_dir("llama_index")
#
# `HuggingFaceEmbedding` passes that `cache_folder` straight to SentenceTransformer, which
# OVERRIDES HF_HOME. So the builder's `SentenceTransformer(...)` bake populates /opt/hf, and the
# runtime's `HuggingFaceEmbedding(...)` looks in ~/.cache/llama_index — a different directory
# that is empty for user ws1. HF_HUB_OFFLINE then turns the miss into
# "couldn't connect to https://huggingface.co ... couldn't find them in the cached files".
#
# Reproduced locally with a hermetic HOME: raw SentenceTransformer loads from the baked cache
# fine; HuggingFaceEmbedding raises LocalEntryNotFoundError against the same cache. The two APIs
# do not share a cache root. Pinning LLAMA_INDEX_CACHE_DIR and populating it here fixes it, and
# the fetch is a tail layer so neither the builder pip layer nor the baked-model layer is touched.
ENV LLAMA_INDEX_CACHE_DIR=/opt/li-cache
RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python -c "\
from llama_index.embeddings.huggingface import HuggingFaceEmbedding; \
e = HuggingFaceEmbedding(model_name='sentence-transformers/multi-qa-MiniLM-L6-cos-v1', device='cpu'); \
print('llama_index cache populated, dim', len(e.get_text_embedding_batch(['bake'])[0]))" \
 && chmod -R a+rX /opt/li-cache

RUN useradd -m -u 10001 ws1 && mkdir -p /app/out && chown -R ws1 /app
USER ws1

# BUILD-TIME PROOF that the baked cache actually loads OFFLINE, as the RUNTIME USER.
#
# The bake at line 34 proves the model downloaded in the *builder*, as *root*, with network.
# It does not prove the runtime stage can load it: different user, no network, and the cache
# arrived via COPY --from. Every one of those is a place this has failed. Without this step the
# image builds green and 32 uvicorn workers discover the problem simultaneously at startup, with
# "Application startup failed. Exiting." and exit code 0 — a broken image that looks healthy.
#
# Runs as ws1 so it also catches permission problems on /opt/hf, and inherits HF_HUB_OFFLINE=1
# from the ENV block, so a build that silently re-downloads cannot pass. Costs ~10 s and
# invalidates nothing above `COPY working/...`.
#
# HOME is forced to a scratch dir for the check so a cache under /root or /home/ws1 cannot
# satisfy it — that leak is exactly what hid this bug: every load "worked" locally because the
# developer's ~/.cache had the model, and the container is the first hermetic environment.
RUN HOME=/tmp/hermetic-check python -c "\
import os; \
assert os.environ.get('HF_HUB_OFFLINE') == '1', 'HF_HUB_OFFLINE not set at build check'; \
from llama_index.embeddings.huggingface import HuggingFaceEmbedding; \
e = HuggingFaceEmbedding(model_name='sentence-transformers/multi-qa-MiniLM-L6-cos-v1', device='cpu'); \
v = e.get_text_embedding_batch(['offline cache check'])[0]; \
assert len(v) == 384, f'expected 384 dims, got {len(v)}'; \
print('OFFLINE CACHE OK: model loads as ws1, no network, no home cache, dim', len(v))" \
 && rm -rf /tmp/hermetic-check

EXPOSE 8801

# 32 workers x 1 BLAS thread each (thread decision settled 2026-08-15; matches Shashi
# compose.yml:37-39,63-65,90 and Leela docker-compose.yml:71). The BLAS pins are already in the
# ENV block above and are unchanged; TORCH_INTEROP_THREADS stays UNSET on both arms, deliberately.
# WS1_WORKERS is read by uvicorn (--workers) AND by service.py:39 for its own /health report, so
# one variable keeps the two from disagreeing.
# 24, not 32: the arm runs on cpuset 0-23 and one worker per core is the tuning. A worker count
# above the cpuset width oversubscribes and measures scheduler thrash. Read back at runtime via
# /health rather than trusted from here.
ENV WS1_WORKERS=24 \
    WS1_PORT=8801

# sh -c + exec: exec form cannot expand ${WS1_WORKERS}; `exec` keeps uvicorn as PID 1 so SIGTERM
# reaches it and workers shut down cleanly instead of being killed at the 10 s timeout.
#
# The `rm -rf` is the readiness markers. `docker start` reuses the writable layer AND restarts the
# PID namespace at 1, so without this the previous run's markers survive under a supervisor key
# that the new run can collide with, and warm_workers counts both runs (observed: 33 of 32).
# Clearing here is race-free — it happens before any worker exists. The service also keys markers
# by supervisor start time, and the driver refuses warm_workers > declared_workers; this is the
# cheapest of the three and stops the directory growing without bound.
ENTRYPOINT ["sh", "-c", "rm -rf /tmp/ws1_warm; exec python -m uvicorn ws1.service:app --host 0.0.0.0 --port 8801 --workers ${WS1_WORKERS:-32} --loop uvloop --http httptools --no-access-log --log-level warning --timeout-keep-alive 30"]
