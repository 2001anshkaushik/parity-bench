# ---------------------------------------------------------------------------------------------
# RocketRide engine — linux-x64, FIRST EVER IMAGE (2026-08-14). Never buildable before Phase 2:
# zero linux-arm64 assets exist across all 51 engine releases, so this could not be built or
# tested on the arm64 laptop. Everything below derives from direct inspection of the release
# asset (ELF headers, DT_NEEDED, bundled JRE) — see publishable/BUILD_ON_EC2.md — but the image
# itself is UNVERIFIED until it runs on an x86-64 host.
#
# Facts this file is built on (all measured, not assumed):
#   * ELF requires glibc >= 2.35  -> Ubuntu 22.04 minimum (20.04 = glibc 2.31 will not load it)
#   * DT_NEEDED: libc.so.6, libm.so.6, ld-linux, libjvm.so, libc++.so.1, libc++abi.so.1,
#     libunwind.so.1, libgcc_s.so.1  -> engine links LLVM libc++, NOT libstdc++
#   * DT_RUNPATH = $ORIGIN/lib:$ORIGIN/java/jre/lib/server  -> libjvm comes from the BUNDLED JRE
#     (Temurin 17.0.19, 393 files). Do NOT install a system Java.
#   * the bundle ships CPython 3.12 for nodes; no system Python needed for the engine itself
#   * tarball sha256 pinned below — measured from the asset we downloaded and inspected
# ---------------------------------------------------------------------------------------------
ARG EXPECT_ARCH=x86_64
FROM ubuntu:22.04
ARG EXPECT_ARCH
RUN [ "$(uname -m)" = "$EXPECT_ARCH" ] || \
    (echo "ARCH ASSERT FAILED: $(uname -m) != EXPECT_ARCH=$EXPECT_ARCH — never emulate silently" && exit 1)

# Hard runtime deps only (DT_NEEDED), plus curl/ca-certs for the pinned fetch.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libc++1 libc++abi1 libunwind8 lsof \
        curl ca-certificates python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# --- engine bundle, pinned by sha256 (a tag is mutable; a hash is not — Shashi's discipline) ----
ARG ENGINE_URL=https://github.com/rocketride-org/rocketride-server/releases/download/server-v3.3.1/rocketride-server-v3.3.1-linux-x64.tar.gz
ARG ENGINE_SHA256=d8dad45bd084c65443ddb5907965ee1c8424f82fa5dcd5b11476ed66ce0281d8
WORKDIR /opt/rocketride/engine
RUN curl -fL --retry 3 "$ENGINE_URL" -o /tmp/engine.tgz \
    && echo "$ENGINE_SHA256  /tmp/engine.tgz" | sha256sum -c - \
    && tar -xzf /tmp/engine.tgz -C /opt/rocketride/engine \
    && rm /tmp/engine.tgz
# NOTE: the tarball has NO top-level directory — extract FLAT. --strip-components=1 destroys it.

# --- pypdf into the engine's EMBEDDED interpreter — the former hand-copy, now a real build step --
# There is no supported package-management path for the embedded CPython. This reproduces exactly
# what the hand-copy did, deterministically: install the PINNED version to a staging dir with the
# matching interpreter version, then place package + dist-info into the embedded site-packages.
# Needed ONLY for the legacy pdf_probe node; the Phase 2 all-stock 5-node pipeline does not use it.
ARG PYPDF_VERSION=6.15.0
RUN pip3 install --no-cache-dir --target /tmp/pdflibs "pypdf==${PYPDF_VERSION}" \
    && cp -R /tmp/pdflibs/pypdf /opt/rocketride/engine/lib/python3.12/site-packages/ \
    && cp -R /tmp/pdflibs/pypdf-*.dist-info /opt/rocketride/engine/lib/python3.12/site-packages/ \
    && rm -rf /tmp/pdflibs \
    && /opt/rocketride/engine/bin/python3 -c "import pypdf; print('embedded pypdf', pypdf.__version__)" \
        || echo "WARN: embedded-interpreter import check could not run (bin layout differs) — verify at first boot"

# --- benchmark nodes: env_probe is REQUIRED (the in-process thread-parity gate reads through it).
# The engine loads nodes from engine/nodes/, not from the repo.
COPY working/nodes/env_probe /opt/rocketride/engine/nodes/env_probe
COPY working/nodes/pdf_probe /opt/rocketride/engine/nodes/pdf_probe

# Threads: deliberately NOT pinned here. Thread policy is the harness's decision (config gate reads
# it back in-process); baking a pin into the image would hide the largest lever we measured (3.07x).
ENV ROCKETRIDE_APIKEY=local-dev
EXPOSE 5565
WORKDIR /opt/rocketride/engine
# The engine binary execs from its own directory so $ORIGIN RUNPATHs resolve.
ENTRYPOINT ["./engine", "ai/eaas.py"]
