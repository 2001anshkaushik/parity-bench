# ---------------------------------------------------------------------------------------------
# RocketRide engine — linux-x64. Multi-stage: `engine` (filesystem), `bootcheck` (throwaway
# stage that MUST boot the engine before the build may go green), final (engine + entrypoint).
#
# HISTORY THIS FILE MUST NOT REPEAT. The first Phase-2 build of this recipe went green and then
# crash-looped on the box: "Failed to compile constraints ... onnxruntime-gpu==1.20.1". That
# patch was documented in publishable/STATE.md §1, applied in the runbook-era image, and present
# in Leela's proven Dockerfile — and this file, written fresh on 2026-08-14, carried none of it
# (verified: zero occurrences across this file's entire git history). Two of Leela's steps even
# credit our old image as their source; the knowledge made a round trip through her repo while
# falling out of ours. This revision restores full parity with her proven file (differences are
# listed inline with reasons) and adds the bootcheck stage so a green build that cannot start
# the engine is no longer a possible outcome.
#
# Facts this file is built on (all measured, not assumed):
#   * ELF requires glibc >= 2.35  -> Ubuntu 22.04 minimum (20.04 = glibc 2.31 will not load it)
#   * DT_NEEDED: libc.so.6, libm.so.6, ld-linux, libjvm.so, libc++.so.1, libc++abi.so.1,
#     libunwind.so.1, libgcc_s.so.1  -> engine links LLVM libc++, NOT libstdc++
#   * DT_RUNPATH = $ORIGIN/lib:$ORIGIN/java/jre/lib/server  -> libjvm comes from the BUNDLED JRE
#     (Temurin 17.0.19, 393 files). Do NOT install a system Java.
#   * the bundle ships CPython 3.12 for nodes; no system Python needed for the engine itself
#   * TWO pins, different failure modes: the tarball sha256 catches a swapped or corrupted
#     download; the extracted-binary sha256 (Leela's pin — the artifact that actually
#     determines behaviour) catches extraction and flattening errors.
#
# NOT adopted from Leela's file, with reasons:
#   * base python:3.12-slim-bookworm -> we keep ubuntu:22.04. Our base came from the measured
#     glibc floor and DT_NEEDED (incl. libunwind8, which she omits and bookworm's libc++ chain
#     happens to supply); the bundle ships its own CPython, so a python base buys nothing.
#   * FROM --platform=linux/amd64 (permits emulation, "correctness only, never timings") -> we
#     keep the hard EXPECT_ARCH assert. Never emulate silently is a standing rule here.
#   * WORKDIR /work + COPY data/ -> her bench fixture dir. Our corpus mounts from the host; a
#     baked copy drifts — her own file refuses to bake the pipe for exactly this reason.
#   * her unconditional LABEL -> kept our conditional two-key form; hers labels a stock build
#     as patched (reported to her).
# ---------------------------------------------------------------------------------------------
ARG EXPECT_ARCH=x86_64
FROM ubuntu:22.04 AS engine
ARG EXPECT_ARCH
RUN [ "$(uname -m)" = "$EXPECT_ARCH" ] || \
    (echo "ARCH ASSERT FAILED: $(uname -m) != EXPECT_ARCH=$EXPECT_ARCH — never emulate silently" && exit 1)

# Hard runtime deps only (DT_NEEDED), plus curl/ca-certs for the pinned fetch and procps
# (adopted from Leela: ps inside the container is what a #31-style thread/process question
# needs at 2 a.m., and it costs nothing).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libc++1 libc++abi1 libunwind8 lsof procps \
        curl ca-certificates python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

ENV ENGINE_DIR=/opt/rocketride/engine \
    ROCKETRIDE_APIKEY=local-dev \
    ROCKETRIDE_URI=ws://127.0.0.1:5565/task/service \
    RR_ENGINE_DIR=/opt/rocketride/engine \
    RR_PORT=5565 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# --- engine bundle: tarball pin (ours) + extracted-binary pin (Leela's) ------------------------
# ENGINE_BIN_SHA256 is the hash of the EXTRACTED `engine` ELF — "the artifact that actually
# determines behavior" (her words), verified by her 2026-08-14. Checked AFTER flattening so the
# hash is always taken at the same path regardless of archive layout.
ARG ENGINE_URL=https://github.com/rocketride-org/rocketride-server/releases/download/server-v3.3.1/rocketride-server-v3.3.1-linux-x64.tar.gz
ARG ENGINE_SHA256=d8dad45bd084c65443ddb5907965ee1c8424f82fa5dcd5b11476ed66ce0281d8
ARG ENGINE_BIN_SHA256=95768e2640df2d34dd6dfea2e456f36da03ad80b091f9d057c116dfe748d9747
WORKDIR /opt/rocketride/engine
RUN curl -fL --retry 3 "$ENGINE_URL" -o /tmp/engine.tgz \
    && echo "$ENGINE_SHA256  /tmp/engine.tgz" | sha256sum -c - \
    && tar -xzf /tmp/engine.tgz -C "$ENGINE_DIR" \
    && rm /tmp/engine.tgz \
    # The asset we measured is FLAT (no top-level dir), but some release tarballs nest one.
    # Flatten if so (Leela's guard — which her file credits to our runbook-era image; the step
    # fell out of ours when this file was written fresh). Runs before the binary checksum.
    && if [ ! -f "$ENGINE_DIR/engine" ]; then \
         inner="$(find "$ENGINE_DIR" -maxdepth 2 -name engine -type f | head -1)"; \
         [ -n "$inner" ] && mv "$(dirname "$inner")"/. "$ENGINE_DIR"/ 2>/dev/null || true; \
       fi \
    && test -f "$ENGINE_DIR/engine" && test -f "$ENGINE_DIR/ai/eaas.py" \
    && echo "$ENGINE_BIN_SHA256  $ENGINE_DIR/engine" | sha256sum -c - \
    && chmod +x "$ENGINE_DIR/engine"

# --- onnxruntime boot fix (engine 3.3.0 AND 3.3.1) — Leela's block, adopted whole -------------
# ai/common/models/gliner/requirements_gliner.txt pins
#     onnxruntime-gpu==1.20.1 ; platform_system != 'Darwin'
# and onnxruntime-gpu 1.20.1 WAS NEVER PUBLISHED to PyPI (1.20.0 and 1.20.2 exist). The engine
# compiles ALL requirements files at boot, so this unsatisfiable pin — in an OPT-IN NER feature
# this benchmark never loads — kills boot on ANY Linux host:
#     Failed to compile constraints: No solution found ... onnxruntime-gpu==1.20.1
# The pin appears in FIVE files across BOTH ai/ and nodes/:
#   ai/common/models/{audio/requirements_whisper,vision/requirements_pose,
#                     gliner/requirements_gliner}.txt
#   nodes/{audio_transcribe,anonymize}/requirements.txt
# ALL must move together — patching only some is WORSE ("you require ==1.20.1 and ==1.20.2"),
# because constraint compilation is global across every requirements file in the tree. Scope is
# every *.txt, not just requirements*.txt, so a constraints-style file is caught too.
# find -exec rather than `grep -rl | xargs sed`: once upstream fixes the pin, grep matches
# nothing and bare xargs would run sed with no files, blocking on stdin and hanging the build.
# MUST run before any boot — including the bootcheck stage below.
RUN find "$ENGINE_DIR" -name '*.txt' -exec \
      sed -i 's/onnxruntime-gpu==1\.20\.1/onnxruntime-gpu==1.20.2/g' {} + \
    && echo "--- onnxruntime-gpu pins after patch (must all be 1.20.2):" \
    && (grep -rn "onnxruntime-gpu==" "$ENGINE_DIR" --include='*.txt' || true) \
    && ! grep -rq "onnxruntime-gpu==1\.20\.1" "$ENGINE_DIR" --include='*.txt'

# --- pypdf into the engine's EMBEDDED interpreter — the former hand-copy, now a real build step --
# There is no supported package-management path for the embedded CPython. This reproduces exactly
# what the hand-copy did, deterministically: install the PINNED version to a staging dir with the
# matching interpreter version, then place package + dist-info into the embedded site-packages.
# Needed ONLY for the legacy pdf_probe node; the Phase 2 all-stock 5-node pipeline does not use it.
ARG PYPDF_VERSION=6.15.0
RUN pip3 install --no-cache-dir --target /tmp/pdflibs "pypdf==${PYPDF_VERSION}" \
    && cp -R /tmp/pdflibs/pypdf /opt/rocketride/engine/lib/python3.12/site-packages/ \
    && cp -R /tmp/pdflibs/pypdf-*.dist-info /opt/rocketride/engine/lib/python3.12/site-packages/ \
    && rm -rf /tmp/pdflibs \
    && /opt/rocketride/engine/bin/python3 -c "import pypdf; print('embedded pypdf', pypdf.__version__)" \
        || echo "WARN: embedded-interpreter import check could not run (bin layout differs) — verify at first boot"

# --- BUG_CHUNK_DUPLICATION correction (RocketRide 3.3.1) -----------------------------------------
# Ported from Leela's aws_bench/arms/rocketride/Dockerfile at a5c3b5d, mechanism unchanged.
#
# nodes/embedding_transformer/IInstance.py calls _flushDocuments(), which already delivers the
# batch downstream, and then falls through to the node's default forwarding action — emitting the
# SAME document list a second time. Measured: Leela 51/987 documents came back [A,B,C,A,B,C] at
# repeat_factor 2 against 0/987 for LangGraph; ours 5/199. preventDefault() after the flush
# suppresses the second emission.
#
# This MODIFIES THE PRODUCT UNDER TEST, so it is a build ARG. RR_DUP_PATCH=0 builds stock 3.3.1
# so the delta can be measured rather than assumed.
#
# Four guards, all fail-closed — the && chain IS the `then` branch, so any failure exits non-zero
# and fails the build: file present; exactly ONE preventDefault before (source-shape check, so a
# future engine that already fixed this cannot be double-patched); the awk anchors on the comment
# line AND the 8-space-indented call; exactly TWO after (the patch demonstrably took).
ARG RR_DUP_PATCH=1
RUN if [ "$RR_DUP_PATCH" = "1" ]; then \
      F="$(find /opt/rocketride/engine -path '*/nodes/embedding_transformer/IInstance.py' \
            -type f | head -1)" \
      && test -n "$F" \
      && [ "$(grep -c 'preventDefault' "$F")" = "1" ] \
      && awk '{ \
           print; \
           if (prev ~ /# Flush the documents$/ && \
               $0 ~ /^        self\._flushDocuments\(\)$/) { \
             print "        # BENCH PATCH BUG_CHUNK_DUPLICATION:"; \
             print "        # Flush already delivered this batch downstream."; \
             print "        return self.preventDefault()"; \
           } \
           prev=$0; \
         }' "$F" > "$F.patched" \
      && mv "$F.patched" "$F" \
      && [ "$(grep -c 'preventDefault' "$F")" = "2" ] \
      && echo "BUG_CHUNK_DUPLICATION patch applied to $F"; \
    else echo "BUG_CHUNK_DUPLICATION patch SKIPPED (stock 3.3.1)"; fi
# LABEL FIX vs Leela's version: his LABEL sits outside the `if`, so a RR_DUP_PATCH=0 image is
# still labelled "preventDefault-after-embedding-flush" — a stock build that claims to be patched.
#
# NOT fixed with `${RR_DUP_PATCH:+...}`: `:+` substitutes when the variable is set and NON-EMPTY,
# and the string "0" is non-empty, so RR_DUP_PATCH=0 would still expand to the patched label. That
# is the same bug with extra steps. The flag itself is carried instead, and the patch id names
# only WHICH patch the flag refers to. These two keys are exactly Leela's REQUIRED provenance
# fields, so `docker inspect` and our result JSON now agree by construction.
ARG RR_DUP_PATCH
LABEL benchmark.rocketride.engine_version="3.3.1" \
      benchmark.rocketride.duplication_patch_applied="${RR_DUP_PATCH}" \
      benchmark.rocketride.duplication_patch_id="preventDefault-after-embedding-flush"
# -------------------------------------------------------------------------------------------------

# Client SDK pinned to the version the probe was verified against (Leela's pin). Used by the
# bootcheck stage for a real WebSocket handshake, and available in-container for debugging.
# Installs into apt python3 (3.10) where hers is 3.12; if the pin refuses 3.10 this step fails
# loudly here, not silently later.
RUN pip3 install --no-cache-dir "rocketride==1.3.0"

# --- benchmark nodes: env_probe is REQUIRED (the in-process thread-parity gate reads through it).
# The engine loads nodes from engine/nodes/, not from the repo.
COPY working/nodes/env_probe /opt/rocketride/engine/nodes/env_probe
COPY working/nodes/pdf_probe /opt/rocketride/engine/nodes/pdf_probe

# ---------------------------------------------------------------------------------------------
# THROWAWAY BOOT CHECK. The failure this exists to prevent: a green build that crash-loops at
# run time, which is exactly what the missing onnx patch produced. This stage boots the engine
# with the SAME binary and the SAME --host/--port flags the entrypoint uses, waits for the
# listener, performs a real SDK WebSocket handshake, and fails the build with the boot log if
# any of that does not happen. Residue (logs, caches, locks) dies with the stage; the runtime
# layers never contain a booted engine's droppings. Costs: this build step needs network (the
# constraints compile resolves against PyPI — the same requirement every first boot has), and
# the compiled constraints cache is discarded with the stage, so first boot on the box
# recompiles it, as it always has.
# RR_BOOT_CHECK=0 skips (offline builds); the skip is recorded in the marker, never silent.
#
# THE COMPILED CONSTRAINTS CACHE IS CARRIED FORWARD, not discarded. The engine keys this cache
# on md5 over each requirements file's path:size:mtime (depends.py, read in session 29), and
# both this stage and the final stage inherit the SAME engine-stage layers — identical paths,
# bytes and mtimes — so the key matches by construction and first container boot skips the
# 10-30 min compile. A key miss degrades to a recompile, never to wrongness. What is carried is
# EXACTLY $ENGINE_DIR/cache; boot logs, /tmp and any lock files still die with the stage. This
# also freezes dependency RESOLUTION at image-build time and captures it in the image digest —
# first-boot resolution floats with PyPI state, so baking it is the more reproducible of the
# two, and it gives this image the hermetic-at-runtime property the LlamaIndex image has had
# since its model bake. NOT warmed: anything materialised at first use() — this stage never
# spawns a task.
# ---------------------------------------------------------------------------------------------
FROM engine AS bootcheck
ARG RR_BOOT_CHECK=1
ARG RR_BOOT_TIMEOUT_S=600
COPY docker/bootcheck_rocketride.py /tmp/bootcheck_rocketride.py
RUN if [ "$RR_BOOT_CHECK" = "1" ]; then \
      RR_BOOT_TIMEOUT_S="$RR_BOOT_TIMEOUT_S" python3 /tmp/bootcheck_rocketride.py; \
    else \
      # The cache dir must exist even on skip, or the final stage's COPY fails the build.
      # A skipped build ships an EMPTY cache and the marker says so — first boot compiles.
      mkdir -p "$ENGINE_DIR/cache" \
      && echo "boot check SKIPPED (RR_BOOT_CHECK=0) — constraints cache NOT prewarmed" \
         | tee /tmp/boot-ok; \
    fi

# ---------------------------------------------------------------------------------------------
# Final image: the engine stage plus the entrypoint. The marker COPY is what FORCES the
# bootcheck stage to run — remove it and the check silently stops executing.
# ---------------------------------------------------------------------------------------------
FROM engine
COPY --from=bootcheck /tmp/boot-ok /opt/rocketride/.boot-check
# The compiled constraints cache from the verified boot — see the bootcheck header for why this
# is carried and what is deliberately NOT. Cold-boot compile stays measurable when wanted:
# `rm -rf /opt/rocketride/engine/cache` inside a container restores it.
COPY --from=bootcheck /opt/rocketride/engine/cache /opt/rocketride/engine/cache
ARG RR_BOOT_CHECK=1
LABEL benchmark.rocketride.constraints_cache_prewarmed="${RR_BOOT_CHECK}"
COPY docker/rocketride-entrypoint.sh /usr/local/bin/rocketride-entrypoint.sh
RUN chmod +x /usr/local/bin/rocketride-entrypoint.sh

# Threads: deliberately NOT pinned here. Thread policy is the harness's decision (config gate reads
# it back in-process); baking a pin into the image would hide the largest lever we measured (3.07x).
EXPOSE 5565
WORKDIR /opt/rocketride/engine
ENTRYPOINT ["/usr/local/bin/rocketride-entrypoint.sh"]
CMD ["serve"]
